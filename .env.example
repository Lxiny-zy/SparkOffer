# LLM (OpenAI-compatible endpoint)
API_BASE=https://your-llm-api-base/v1
API_KEY=sk-your-api-key
MODEL=your-model-name
TEMPERATURE=0.7

# Embedding is required: api | local
EMBEDDING_BACKEND=api

# API mode (default, recommended)
# Leave EMBEDDING_API_BASE empty when using official OpenAI.
# Example below uses Alibaba DashScope's OpenAI-compatible endpoint.
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_API_MODEL=text-embedding-v4

# Local mode (alternative)
# Requires: pip install -r requirements.local-embedding.txt
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_PATH=

# Runtime and auth. Production refuses to start with blank/public defaults.
# For an isolated local demo only, set APP_ENV=development.
APP_ENV=production
# Keep the container's plaintext HTTP listener private. Put HTTPS ingress in
# front of 127.0.0.1:9000; do not use 0.0.0.0 on an Internet-facing host.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Generate secrets, for example: openssl rand -hex 32
JWT_SECRET=
DEFAULT_EMAIL=legend@sparkoffer.local
DEFAULT_PASSWORD=
DEFAULT_NAME=Legend
ALLOW_REGISTRATION=false
# Non-empty INVITE_CODE additionally requires this code at registration
INVITE_CODE=
# Set the exact HTTPS browser origin(s), comma-separated; production rejects
# wildcard and non-loopback plaintext origins.
CORS_ALLOW_ORIGINS=https://app.example.com
# Only these direct peers may supply X-Real-IP/X-Forwarded-For.
# Compose defaults to its proxy gateway plus fixed frontend container address.
TRUSTED_PROXY_CIDRS=

# Interview tuning (optional)
MAX_QUESTIONS_PER_PHASE=5
MAX_DRILL_QUESTIONS=15

# Redis (optional — leave empty to use in-memory LRU fallback)
# Docker compose injects redis://redis:6379/0 automatically.
REDIS_URL=

# Vector store backend — numpy | qdrant
# 裸 uvicorn 本地开发：留空 = numpy（SQLite + 暴力余弦，零额外依赖）。
# Docker compose 部署：compose 已注入默认 VECTOR_BACKEND=qdrant + QDRANT_URL=http://qdrant:6333，
# 此处留空即用 Qdrant；显式设 VECTOR_BACKEND=numpy 可退回本地。
# 注意 qdrant-only：配置走 Qdrant 后连不上不会降级 numpy，检索会降级为空上下文并后台重试。
VECTOR_BACKEND=
QDRANT_URL=
# Upgrade deliberately after taking a Qdrant snapshot and testing restore.
QDRANT_IMAGE=qdrant/qdrant:v1.12.0
# Required by Docker Compose. Generate independently from JWT_SECRET.
QDRANT_API_KEY=
